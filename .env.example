# AI. Достаточно задать ключ: провайдер выберется сам (OPENAI_API_KEY → openai, ANTHROPIC_API_KEY → anthropic).
# AI_PROVIDER: openai | anthropic | mock | none. mock отвечает шаблонами без сети — для демо и разработки.
# На Vercel ключ добавляется командой: vercel env add OPENAI_API_KEY production --sensitive
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# Модель и запасные (через запятую) — если основная перегружена или недоступна ключу.
# По умолчанию для OpenAI: gpt-5.4-mini, запасные gpt-5.4-nano, gpt-5.4; для Anthropic: claude-opus-5-5.
AI_MODEL=
AI_FALLBACK_MODELS=
AI_EFFORT=
AI_MAX_TOKENS=
AI_TIMEOUT_MS=120000
# Дневные лимиты запросов к AI (сутки по UTC): вошедший пользователь, гость (по хэшу IP), весь сервис
AI_DAILY_LIMIT_USER=50
AI_DAILY_LIMIT_GUEST=15
AI_DAILY_LIMIT_TOTAL=1500

# Аккаунты и синхронизация. На Vercel: Storage → Upstash for Redis → Connect — переменные
# KV_REST_API_URL и KV_REST_API_TOKEN появятся сами. Без них вход скрыт, данные только в браузере.
# DB_PROVIDER=memory — аккаунты в памяти процесса для локальной разработки (сбрасываются при перезапуске).
KV_REST_API_URL=
KV_REST_API_TOKEN=
DB_PROVIDER=
