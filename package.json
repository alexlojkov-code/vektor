{
  "name": "vektor",
  "version": "0.1.0",
  "private": true,
  "description": "Вектор — AI-ассистент для маркетологов: чат по направлениям, задачи, калькулятор метрик",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:3d": "esbuild src/scene3d.js --bundle --format=esm --minify --target=es2020 --outfile=public/js/scene3d.min.js",
    "build:og": "node scripts/og-image.mjs",
    "eval:ai": "node scripts/ai-eval.mjs",
    "test:e2e": "node tests/e2e/screens.mjs && node tests/e2e/main.mjs && node tests/e2e/extra.mjs",
    "test:e2e:main": "node tests/e2e/main.mjs",
    "test:e2e:extra": "node tests/e2e/extra.mjs",
    "test:e2e:screens": "node tests/e2e/screens.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "three": "0.186.1"
  }
}
